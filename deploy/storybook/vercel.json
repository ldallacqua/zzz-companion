{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @zzz/web...",
  "buildCommand": "cd ../.. && pnpm --filter @zzz/web exec storybook build --quiet -o ../../deploy/storybook/dist",
  "outputDirectory": "dist",
  "ignoreCommand": "echo \"Storybook: env '$VERCEL_ENV', branch '$VERCEL_GIT_COMMIT_REF'\"; [ -n \"$VERCEL_GIT_COMMIT_REF\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != main ] && [ \"$VERCEL_ENV\" != production ]"
}
