# Copy to .env for local overrides. Development needs none of these.
# PORT=8787

# Local SQLite file (default) or Turso: libsql://<db>-<org>.turso.io
# DATABASE_URL=file:./.data/dev.db
# DATABASE_AUTH_TOKEN=

# 32+ random characters (openssl rand -base64 32). Required in production.
# BETTER_AUTH_SECRET=

# Public URL of this API, and the web app origins allowed to call it.
# BETTER_AUTH_URL=http://localhost:8787
# WEB_ORIGINS=http://localhost:3000,http://localhost:3100

# Rate limits on auth endpoints (keep "on"; E2E runs turn them off).
# AUTH_RATE_LIMIT=on
